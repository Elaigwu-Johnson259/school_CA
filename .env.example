# ---- Database ----
DATABASE_URL=postgresql+psycopg2://app_user:app_password@localhost:5432/school_results

# ---- Auth / Security ----
JWT_SECRET=change-this-to-a-long-random-string
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# ---- App ----
ENVIRONMENT=development
BACKEND_CORS_ORIGINS=["http://localhost:5173","http://localhost:4173"]

# ---- File storage ----
STORAGE_BACKEND=local
LOCAL_STORAGE_PATH=./uploads
MAX_UPLOAD_SIZE_MB=5

# ---- AI marking (mock is for local tests only; production requires openai + key) ----
AI_PROVIDER=mock
AI_MODEL=gpt-4o-mini
AI_API_KEY=
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_BASE_URL=
AI_BASE_URL=

# ---- Frontend (used by Vite, must be prefixed VITE_) ----
VITE_API_BASE_URL=http://localhost:8000/api
